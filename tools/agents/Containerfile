# The agent workstation: the Paseo daemon and the coding-agent CLIs it drives,
# with the tools this repository's checks need. Why it is a container, and
# what it deliberately holds no credentials for, is ADR-0027; how to build,
# run and remove it is tools/agents/README.md.
#
# Every version is pinned. Adding an agent CLI is one more pinned package in
# the npm line below, then a login inside the container.

FROM ghcr.io/getpaseo/paseo:0.15.2@sha256:e12414fe71f33aa7cedf1eaf027bf2acfccdf01d6b692ba779a220b2ec1c46e6

# Dictation is on by default and downloads about 630 MB of local speech
# models at startup. Nothing here uses voice.
ENV PASEO_DICTATION_ENABLED=false

# uv runs every Python check in the repository (tools, services, warehouse).
COPY --from=ghcr.io/astral-sh/uv:0.13.7@sha256:96f40d3904aad8d0bd010539001d36c8e2188b981e1334471a90c4a1d93bb490 /uv /uvx /usr/local/bin/

# Root only for installing: the base entrypoint prepares the mounted volumes,
# then drops the daemon and every agent it launches to the non-root user
# `paseo`.
USER root

# helm renders the Argo CD Applications for the budget and manifest-policy
# checks, at the version CI uses; gh reads and opens pull requests. Both are
# release binaries checked against their published SHA-256.
ARG HELM_VERSION=4.3.0
ARG HELM_SHA256=31c5794dd55c66a51e6b7d2e2ac7a114ae8b1de41ff1d9ba51748ac973b06a08
ARG GH_VERSION=2.103.3
ARG GH_SHA256=ee32df2323c8847f5fac6cb6b4b69ca75828e9329a8f22f677021f7b3306ce63
RUN set -eux; \
    cd /tmp; \
    curl -fsSLo helm.tgz "https://get.helm.sh/helm-v${HELM_VERSION}-linux-arm64.tar.gz"; \
    echo "${HELM_SHA256}  helm.tgz" | sha256sum -c -; \
    tar -xzf helm.tgz linux-arm64/helm; \
    install -m 0755 linux-arm64/helm /usr/local/bin/helm; \
    curl -fsSLo gh.tgz "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_arm64.tar.gz"; \
    echo "${GH_SHA256}  gh.tgz" | sha256sum -c -; \
    tar -xzf gh.tgz "gh_${GH_VERSION}_linux_arm64/bin/gh"; \
    install -m 0755 "gh_${GH_VERSION}_linux_arm64/bin/gh" /usr/local/bin/gh; \
    rm -rf /tmp/*

# iproute2 for the blackhole routes in entrypoint.sh.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends iproute2; \
    rm -rf /var/lib/apt/lists/*

COPY --chmod=0755 entrypoint.sh /usr/local/bin/lagom-agents-entrypoint
ENTRYPOINT ["/usr/local/bin/lagom-agents-entrypoint"]

RUN set -eux; \
    npm install -g \
      @anthropic-ai/claude-code@2.1.318 \
      @openai/codex@0.166.0; \
    npm cache clean --force
