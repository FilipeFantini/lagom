# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

# Environment and secrets — never commit real values
.env
.env.*
!.env.example
*.pem
*.key
secrets.yaml
!*-sealed.yaml

# dlt — a pattern containing a slash is anchored to the repository root, so
# **/ is what makes these match inside data/sources/<name>/ too
**/.dlt/secrets.toml
**/.dlt/*.duckdb

# dbt
target/
dbt_packages/
logs/
.user.yml

# DuckDB working files
*.duckdb
*.duckdb.wal

# Local data — never in Git. `data/` matches a directory of that name at any
# depth, so the repository's own top-level data/ (ADR-0053) is re-included;
# a nested data/ inside it stays ignored.
data/
!/data/
*.parquet

# Kubernetes
kubeconfig
*.kubeconfig

# OS and editors
.DS_Store
.vscode/
.idea/
