---
import { ClientRouter } from "astro:transitions";
import "@fontsource-variable/fraunces/wght.css";
import "@fontsource-variable/fraunces/wght-italic.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonical: string;
  current?: "home" | "projects";
  inventory: "biography" | "platform" | "none";
  figurePage?: string;
}

const { title, description, canonical, current, inventory, figurePage } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#14181f" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body data-inventory={inventory} data-figure-page={figurePage}>
    <a class="skip" href="#content">Skip to content</a>
    <header class="mast">
      <div class="wrap mast-row">
        <a class="wordmark" href="/">
          <span class="wordmark-name">Filipe Fantini</span>
          <span class="wordmark-host">ofantini.com</span>
        </a>
        <nav class="nav" aria-label="Pages">
          <a href="/" aria-current={current === "home" ? "page" : undefined}>Home</a>
          <a href="/projects" aria-current={current === "projects" ? "page" : undefined}>Projects</a>
        </nav>
      </div>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="colophon">
      <div class="wrap">
        <p>
          Static files. No analytics, no cookies, no third-party script.
          <a href="https://github.com/FilipeFantini/lagom">The repository is public.</a>
        </p>
      </div>
    </footer>
  </body>
</html>
